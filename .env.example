SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/llm_gateway
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password

# Shared secret for the admin API (/api/tenants, /api/projects, /api/keys, /api/models,
# /api/pricing, /api/quotas, POST /api/invoices/generate). Callers pass it as X-Admin-Token.
# Leave unset for a local demo: the admin API stays open and a warning is logged at startup.
ADMIN_API_TOKEN=

# Comma-separated origins allowed to call /api/**, e.g. https://tollgate.example.com
# Unset means any origin, which is fine locally and wrong in production.
CORS_ALLOWED_ORIGINS=
